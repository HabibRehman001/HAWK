# Server
PORT=3000
NODE_ENV=development

# CORS — frontend origin allowed to hit this API
CLIENT_URL=http://localhost:5173

# Where contact form emails are delivered
MAIL_TO=you@example.com

# SMTP credentials (Gmail app password, Resend SMTP, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASS=your-smtp-app-password

# Optional “from” identity (defaults to SMTP_USER if empty)
SMTP_FROM_NAME=BlueHawk Website
SMTP_FROM_EMAIL=
